# ============================================================
# BRANKAS BACKEND CONFIGURATION
# ============================================================

# Server
PORT=8787

# Frontend GitHub Pages
FRONTEND_ORIGIN=https://kiw63.github.io

# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE

# ============================================================
# BRANKAS SECURITY
# ============================================================

# Buat string acak panjang, minimal 32 karakter
SESSION_SECRET=GANTI_DENGAN_SECRET_RANDOM_PANJANG

# Redeem code pertama kali setup BRANKAS
REDEEM_CODE=GANTI_DENGAN_REDEEM_CODE_RAHASIA

# ============================================================
# CLOUDFLARE R2
# ============================================================

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

R2_ACCESS_KEY_ID=GANTI_DENGAN_R2_ACCESS_KEY_ID

R2_SECRET_ACCESS_KEY=GANTI_DENGAN_R2_SECRET_ACCESS_KEY

R2_BUCKET=brankas-vault

# ============================================================
# FILE LIMIT
# ============================================================

MAX_FILE_SIZE_BYTES=5368709120

# ============================================================
# TIKTOK
# ============================================================

# 0 = disabled
# 1 = enabled
#
# Jangan aktifkan sebelum server memiliki yt-dlp.
ALLOW_YTDLP=0
